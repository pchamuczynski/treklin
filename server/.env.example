# Copy to server/.env (git-ignored). These values stay on the server.

NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/map-runner.sqlite

# The frontend's origin(s), comma-separated. Requests from other origins are rejected.
APP_ORIGIN=http://localhost:5173

# Google sign-in: OAuth 2.0 Client ID (type "Web application") from
# https://console.cloud.google.com/apis/credentials - the same value as VITE_GOOGLE_CLIENT_ID.
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=519589243494-4md78gmn5dik6i9utr2gbbe1b3vgnhn1.apps.googleusercontent.com

SESSION_TTL_DAYS=30

# Production behind a reverse proxy (nginx, a PaaS router, ...): number of proxy hops, e.g. 1.
TRUST_PROXY=
# Production: serve the built frontend from this server, e.g. ../dist
CLIENT_DIST=

# Garmin Health API (developer portal). Leave empty until a developer app exists.
# The portal must allow APP_ORIGIN + /api/integrations/garmin/callback
# and the push URL APP_ORIGIN + /api/integrations/garmin/push.
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
# Own-account testing without a developer app. Pulls only the key owner's activities.
# Ignored when both consumer credentials above are set.
GARMIN_PERSONAL_KEY=

# Comma-separated account emails that may open /admin. Leave empty to disable the panel.
# Checked when the server starts, and again when an account with one of these emails is created.
ADMIN_EMAILS=

# Strava API (https://www.strava.com/settings/api). The secret stays in this file.
# Authorization Callback Domain is only the host: treklin.com for the live site, localhost while testing locally.
# The connect flow sends athletes back to APP_ORIGIN + /api/integrations/strava/callback.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
